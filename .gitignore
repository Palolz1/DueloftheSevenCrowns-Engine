# Godot 4+ specific ignores
.godot/
/android/

# godot-cpp build artifacts (regenerated by scons, not needed in vcs)
godot-cpp/bin/
godot-cpp/gen/
godot-cpp/.sconsign.dblite
godot-cpp/__pycache__/

# duel-engine build intermediates
duel-engine/src/*.o
duel-engine/.sconsign.dblite
duel-engine/.sconsign*.dblite

# exported game builds (produced locally/by CI, not source)
duel-engine/demo/GameFolder/
duel-engine/demo/GameFolderLinux/
duel-engine/demo/GameFolderMac/
duel-engine/demo/*.exe
duel-engine/demo/*.pck
duel-engine/demo/*.dll
duel-engine/demo/*.dylib
duel-engine/demo/*.so

# stray Godot scene-merge tmp files
*.tscn[0-9]*.tmp

# keep the actual gdextension binaries that ship with the game, but not
# intermediate static-link archives
duel-engine/demo/bin/*.a
duel-engine/demo/bin/*.lib
duel-engine/demo/bin/*.exp
duel-engine/demo/bin/*.pdb
